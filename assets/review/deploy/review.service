# The proofreading site's API under waitress, on 127.0.0.1:8087 only.
# Install: sudo cp review.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=Proofreading site API (review)
After=network.target

[Service]
Type=simple
User=review
Group=review
WorkingDirectory=/srv/review/app
Environment=REVIEW_DATA=/var/lib/review
Environment=REVIEW_PORT=8087
Environment=PYTHONDONTWRITEBYTECODE=1
# Each thread otherwise keeps the memory of the largest export it built: about 180-260 MB instead of 111 MB.
Environment=MALLOC_ARENA_MAX=2
ExecStart=/usr/bin/python3 -m server.prod
Restart=always
RestartSec=2
TimeoutStopSec=10

# The data directory /var/lib/review is the only place the service may write.
StateDirectory=review
StateDirectoryMode=0700
UMask=0077

# Sandboxing. Check the result with: systemd-analyze security review
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The API makes outbound connections: signing in with LINE needs LINE's token endpoint (api.line.me) over
# HTTPS, and mail through Resend needs api.resend.com. The lines IPAddressDeny=any and IPAddressAllow=localhost,
# which this file held before, blocked every address but this machine's, so they are gone. The API still
# listens on 127.0.0.1 alone (server/prod.py), so the internet reaches it only through Apache; every other
# protection in this file stays. A mail server on 127.0.0.1 is reached either way. deploy/DEPLOY.md,
# "Updating the code", gives the commands that install this file.
# The API needs only the internet and this machine, so these addresses stay closed to it: link-local, which
# holds DigitalOcean's metadata service at 169.254.169.254; multicast; 10.0.0.0/8, DigitalOcean's private
# network; 100.64.0.0/10; and the private IPv6 range fc00::/7. 172.16.0.0/12 and 192.168.0.0/16 stay open:
# Docker's networks use them, and a mail server in Docker is reached through them even when it is named by its
# public address. systemd allows every address this line does not name.
IPAddressDeny=link-local multicast 10.0.0.0/8 100.64.0.0/10 fc00::/7
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
